# =====================================================================
# NDev Chatbot - copie para .env e preencha. NUNCA versione o .env.
# =====================================================================

NODE_ENV=development
LOG_LEVEL=info

# ---------- URLs ----------
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173

# Unica variavel que chega ao bundle do painel. Prefixo VITE_ e o que o
# Vite exige para expor - todo o resto do .env fica no servidor.
VITE_API_URL=http://localhost:3001

# ---------- Infra (bate com o docker-compose.yml) ----------
DATABASE_URL="postgresql://ndev:ndev@localhost:5432/ndev_chatbot?schema=public"
REDIS_URL="redis://localhost:6379"

# ---------- Segredos ----------
# Assina o JWT de sessao. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Criptografa os tokens OAuth de terceiros no banco (AES-256-GCM).
# Precisa ter EXATAMENTE 64 caracteres hex (32 bytes). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------- Discord ----------
# https://discord.com/developers/applications
#   Bot        -> Token, e LIGUE o "Message Content Intent"
#   OAuth2     -> Redirect: http://localhost:3001/auth/discord/callback
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---------- Twitch ----------
# https://dev.twitch.tv/console/apps
#   OAuth Redirect URL: http://localhost:3001/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Intervalo do polling de live, em segundos (minimo 30).
LIVE_POLL_INTERVAL_SEC=60

# ---------- Dono da instancia ----------
# IDs do Discord (separados por virgula) autorizados a vincular a conta
# do bot na Twitch em /auth/twitch/bot. Descubra o seu com o modo
# desenvolvedor do Discord: clique no seu nome -> Copiar ID.
OWNER_DISCORD_IDS=
